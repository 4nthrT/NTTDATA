          ],
          "port": "8080",
          "path": [
            "api",
            "cursos"
          ]
        }
      }
    },
    {
      "name": "Filtrar por nivel BASICO",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/cursos?nivel=BASICO",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
